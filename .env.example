# =========================================================
# AMBIENTE DA APLICAÇÃO
# =========================================================

# production | staging | development
APPLICATION_MODE=development

# debug | release | test
GIN_MODE=debug

# Imprime configuração no startup (true/false ou 1/0)
PRINT_CONFIG=true


# =========================================================
# SERVIDOR HTTP
# =========================================================

# Porta do servidor (com ou sem :)
SERVER_PORT=4001

# Host onde o servidor escuta
SERVER_HOST=localhost

# Timeout máximo para upload (em segundos)
# Min: 60 | Max: 600
UPLOAD_TIMEOUT_SECONDS=300


# =========================================================
# CORS
# =========================================================

# Lista separada por vírgula
# Ex:
# http://localhost:3000,http://localhost:3002
# OU *
CORS_ORIGINS_ALLOWED=http://localhost:4012


# =========================================================
# POSTGRESQL
# =========================================================

PG_HOST=192.168.0.30
PG_PORT=5432
PG_DB=assjurdb
PG_USER=assjurpg

# OBRIGATÓRIO em production
PG_PASS=senha_forte_aqui


# =========================================================
# POOL DE CONEXÕES DO BANCO
# =========================================================

# Min: 5 | Max: 200
PG_POOLSIZE=25


# =========================================================
# JWT / AUTENTICAÇÃO
# =========================================================

# OBRIGATÓRIO em production
JWT_SECRET=chave_super_secreta_jwt

# Aceita minutos (10) ou duration Go (10m, 1h)
ACCESSTOKEN_EXPIRE=10m
REFRESHTOKEN_EXPIRE=60m


# =========================================================
# CNJ – API PÚBLICA
# =========================================================

# OBRIGATÓRIO em production
CNJ_PUBLIC_API_KEY=sua_chave_cnj

# Deve conter esquema http(s)
CNJ_PUBLIC_API_URL=https://api-publica.cnj.jus.br


# =========================================================
# OPENAI
# =========================================================

# OBRIGATÓRIO em production
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Timeout das chamadas à OpenAI (segundos)
# Min: 30 | Max: 600
OPENAI_OPTION_TIMEOUT_SECONDS=120

# Máx. de tokens de completion
# Min: 256 | Max: 128000
OPENAI_OPTION_MAX_COMPLETION_TOKENS=16384

# Modelo padrão
OPENAI_OPTION_MODEL=gpt-5-mini

# Modelo principal (se vazio, usa OPENAI_OPTION_MODEL)
OPENAI_OPTION_MODEL_TOP=gpt-5-mini

# Modelo secundário (fallback ou tarefas auxiliares)
OPENAI_OPTION_MODEL_SECUNDARY=gpt-5-mini


# =========================================================
# OPENSEARCH
# =========================================================

# Deve conter esquema http(s)
OPENSEARCH_HOST=http://192.168.0.30
OPENSEARCH_PORT=9200

OPENSEARCH_USER=admin

# OBRIGATÓRIO em production
OPENSEARCH_PASSWORD=senha_opensearch_segura

# Nome do índice RAG principal
OPENSEARCH_RAG_NAME=base_doc_embedding


# =========================================================
# (OPCIONAL) ELASTICSEARCH – SE USADO
# =========================================================

# ELASTIC_HOST=http://localhost
# ELASTIC_PORT=9200
# ELASTIC_USER=elastic
# ELASTIC_PASSWORD=senha_elastic
